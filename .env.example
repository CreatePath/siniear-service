# Local development only. Copy to .env; do not commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=siniear
DB_USER=siniear
DB_PASSWORD=replace-with-local-password

# Host ports for the shared Compose stack.
SERVICE_PORT=8000
CALL_PORT=8001

# Development identity selection is opt-in and forbidden in production.
# Compose sets APP_ENV=development for C; standalone defaults to production.
APP_ENV=development
DEV_AUTH_ENABLED=false
# 카카오 개발자 콘솔의 숫자 앱 ID. 0이면 카카오 로그인을 비활성화한다.
KAKAO_APP_ID=0
# 탈퇴 연결 해제용 서버 전용 앱 어드민 키
KAKAO_ADMIN_KEY=

# Directional service credentials. Empty values disable internal API access.
C_TO_T_TOKEN=
T_TO_C_TOKEN=

# Shared Compose: external providers are off by default.
CALL_PROVIDER=disabled
ALLOW_PAID_CALLS=false
PUBLIC_BASE_URL=
KOREAAITEL_ACCOUNT_ID=
KOREAAITEL_API_KEY=
KOREAAITEL_SIGNING_KEY=
KOREAAITEL_FROM_NUMBER=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
GEMINI_SUMMARY_MODEL=

# Standalone C uses these instead of the Compose directional variable names.
INTERNAL_INBOUND_TOKEN=
INTERNAL_OUTBOUND_TOKEN=
INTERNAL_SCOPES=calls:events meetings:read meetings:write interests:write alerts:read
PEER_BASE_URL=http://127.0.0.1:8001
