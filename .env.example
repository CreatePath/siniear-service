# Local development only. Copy to .env; do not commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=siniear
DB_USER=siniear
DB_PASSWORD=replace-with-local-password

# Service host port.
SERVICE_PORT=8000

# Development identity selection is opt-in and forbidden in production.
# Compose sets APP_ENV=development for C; standalone defaults to production.
APP_ENV=development
DEV_AUTH_ENABLED=false
# 카카오 개발자 콘솔의 숫자 앱 ID. 0이면 카카오 로그인을 비활성화한다.
KAKAO_APP_ID=0
# 탈퇴 연결 해제용 서버 전용 앱 어드민 키
KAKAO_ADMIN_KEY=

GEMINI_API_KEY=
# 앱 인터뷰는 기본 fake 사용. 실연동 시 gemini 및 모델 ID 지정.
INTERVIEW_PROVIDER=fake
GEMINI_INTERVIEW_MODEL=
