# Local development only. Copy to .env; do not commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=siniear
DB_USER=siniear
DB_PASSWORD=replace-with-local-password

# Host ports for the shared Compose stack.
SERVICE_PORT=8000
CALL_PORT=8001

# Development identity selection is opt-in and forbidden in production.
# Compose sets APP_ENV=development for C; standalone defaults to production.
APP_ENV=development
DEV_AUTH_ENABLED=false
